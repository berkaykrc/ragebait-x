{
  "manifest_version": 3,
  "name": "Ragebait Detector",
  "version": "0.1.1",
  "description": "Shows a ragebait / engagement-bait band inside X (Twitter) hovercards, based on an account's replies.",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "48": "icon-48.png",
      "96": "icon-96.png",
      "128": "icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["content.js"],
      "css": ["brand.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page.js"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ],
  "host_permissions": [
    "https://api.fxtwitter.com/*",
    "https://ragebait-proxy.dontseemyass.workers.dev/*"
  ],
  "permissions": [
    "storage"
  ],
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{85dba044-1a23-412f-be1c-6a116cff5d54}",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["websiteActivity"]
      }
    }
  }
}
