{
  "name": "ragebait-detector",
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test 'tests/**/*.test.js' 'worker/tests/**/*.test.js'",
    "build": "node esbuild.config.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "icons": "node scripts/icons.mjs",
    "lint:mv3": "node --test tests/build/dual-manifest.test.js",
    "lint": "web-ext lint --source-dir dist-mv2 --warnings-as-errors --self-hosted && npm run lint:mv3",
    "lint:js": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "npm run lint:js && npm run fmt:check && npm run build && npm run check:artifacts && npm run lint && npm test",
    "package": "web-ext build --source-dir dist-mv2 --artifacts-dir web-ext-artifacts",
    "package:mv3": "node scripts/package-mv3.mjs",
    "deploy:production": "node scripts/deploy-worker.mjs production",
    "deploy:staging": "node scripts/deploy-worker.mjs staging",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.0",
    "web-ext": "^10.8.0"
  }
}
