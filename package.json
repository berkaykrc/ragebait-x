{
  "name": "ragebait-detector",
  "version": "0.1.1",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test 'tests/**/*.test.js' 'worker/tests/**/*.test.js'",
    "build": "node esbuild.config.mjs",
    "icons": "node scripts/icons.mjs",
    "lint": "web-ext lint --source-dir dist-mv2 --warnings-as-errors",
    "lint:js": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "npm run lint:js && npm run fmt:check && npm run build && npm run lint && npm test",
    "package": "web-ext build --source-dir dist-mv2 --artifacts-dir web-ext-artifacts",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "web-ext": "^8.0.0",
    "jsdom": "^25.0.0"
  }
}
