{
  "manifest_version": 2,
  "name": "Ragebait Detector",
  "version": "0.1.1",
  "description": "Shows a ragebait / engagement-bait band inside X (Twitter) hovercards, based on an account's replies.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{85dba044-1a23-412f-be1c-6a116cff5d54}",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["websiteActivity"]
      }
    }
  },
  "permissions": [
    "storage",
    "https://api.fxtwitter.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": ["page.js"],
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
