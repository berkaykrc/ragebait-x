{
  "lint": {
    // `assets` is generated output (npm run icons); generated files must not
    // be formatted or linted.
    "exclude": [
      "assets",
      "dist-mv2",
      "dist-mv3",
      "node_modules",
      ".superpowers",
      "docs"
    ],
    "rules": {
      // This is a Node project (node:test, jsdom, esbuild), not a Deno one.
      // Deno's rule set assumes the Deno runtime, so Node globals like
      // setImmediate and process are flagged even though they are the
      // correct API here. Test files rely on setImmediate for microtask
      // settling after a promise chain.
      "exclude": [
        "no-node-globals",
        "no-process-global",
        "no-import-assertions"
      ]
    }
  },
  "fmt": {
    // `assets` is generated output (npm run icons); generated files must not
    // be formatted or linted. `.taste-skill` is design-inspection tooling
    // output (screenshots, generated report.json), never source.
    "exclude": [
      "assets",
      "dist-mv2",
      "dist-mv3",
      "node_modules",
      ".superpowers",
      ".taste-skill",
      "docs"
    ]
  }
}
